{
  "$schema": "connection-graph-v1",
  "description": "Call chain connections between prompt.md, skills, agents, and bin scripts",
  "entryPoint": "../../../.compare-branch/prompt.md",
  "flows": {
    "issue-session": {
      "entry": "../../../.compare-branch/prompt.md",
      "invokes": ["issues:api", "skills/skill-routing/SKILL.md"],
      "description": "Entry point invokes issues API then skill-routing"
    },
    "skill-routing": {
      "file": "skills/skill-routing/SKILL.md",
      "routes": {
        "HAS_ACTIVE_INFRASTRUCTURE_ERROR": "skills/issue-error-recovery/SKILL.md",
        "HAS_QUESTION": "skills/issue-question-response/SKILL.md",
        "STATUS=backlog": "skills/issue-backlog-response/SKILL.md",
        "REVIEW_APPROVED": "skills/issue-merge/SKILL.md",
        "IS_BLOCKED": "skills/issue-blocked/SKILL.md",
        "STATUS=done+HAS_REOPEN_REQUEST": "skills/issue-reopen-and-implement/SKILL.md",
        "STATUS=done": "skills/issue-no-action/SKILL.md",
        "STATUS=needs_review+!HAS_MODIFICATION_REQUEST": "skills/issue-awaiting-review/SKILL.md",
        "PLAN_REQUIRED+!PLAN_APPROVED": "skills/issue-plan/SKILL.md",
        "STATUS=todo+!DOR_MET": "skills/issue-clarification/SKILL.md",
        "PLAN_APPROVED": "skills/issue-implementation-with-plan/SKILL.md",
        "IS_TESTABLE_BUG": "skills/issue-bug/SKILL.md",
        "default": "skills/issue-implementation/SKILL.md"
      }
    }
  },
  "skills": {
    "skill-routing": {
      "file": "skills/skill-routing/SKILL.md",
      "invokes": ["skills/*"],
      "type": "router"
    },
    "issue-plan": {
      "file": "skills/issue-plan/SKILL.md",
      "loads": ["skills/plan/SKILL.md"],
      "spawnsAgents": ["agents/plan-assessor.md", "agents/plan-refactor.md"],
      "chainsTo": ["skills/issue-implementation/SKILL.md"],
      "usesAPI": true
    },
    "issue-implementation": {
      "file": "skills/issue-implementation/SKILL.md",
      "invokesBin": ["bin/create-worktree.sh"],
      "chainsTo": ["skills/issue-merge/SKILL.md"],
      "usesAPI": true,
      "spawnsAgents": ["Explore"]
    },
    "issue-implementation-with-plan": {
      "file": "skills/issue-implementation-with-plan/SKILL.md",
      "invokesBin": ["bin/create-worktree.sh"],
      "spawnsAgents": ["agents/implementer.md", "agents/refactor.md", "agents/implementation-evaluator.md", "Explore"],
      "chainsTo": ["skills/issue-merge/SKILL.md"],
      "usesAPI": true
    },
    "issue-merge": {
      "file": "skills/issue-merge/SKILL.md",
      "invokesBin": ["bin/remove-worktree.sh"],
      "usesAPI": true
    },
    "plan": {
      "file": "skills/plan/SKILL.md",
      "type": "reference",
      "methodologies": [
        "skills/plan/methodology/coherence-checking.md",
        "skills/plan/methodology/document-evolution.md",
        "skills/plan/methodology/nfr-completeness.md",
        "skills/plan/methodology/rationale-capture.md",
        "skills/plan/methodology/scope-management.md",
        "skills/plan/methodology/testability-assessment.md",
        "skills/plan/methodology/vague-language-detection.md"
      ]
    },
    "refactoring": {
      "file": "skills/refactoring/SKILL.md",
      "type": "reference",
      "methodologies": [
        "skills/refactoring/methodology/complexity-assessment.md",
        "skills/refactoring/methodology/duplication-judgment.md",
        "skills/refactoring/methodology/protective-heuristics.md",
        "skills/refactoring/methodology/test-refinement.md"
      ]
    },
    "spike": {
      "file": "skills/spike/SKILL.md",
      "spawnsAgents": ["general-purpose"],
      "description": "Technical investigations in isolated directories"
    },
    "session": {
      "file": "skills/session/SKILL.md",
      "invokesBin": ["bin/find-session-files.sh"]
    }
  },
  "agents": {
    "plan-assessor": {
      "file": "agents/plan-assessor.md",
      "loadsSkills": ["issues:api", "skills/plan/SKILL.md"],
      "purpose": "Evaluate implementation plans for structural compliance"
    },
    "plan-refactor": {
      "file": "agents/plan-refactor.md",
      "loadsSkills": ["issues:api", "skills/plan/SKILL.md"],
      "purpose": "Apply senior engineering judgment to plans"
    },
    "implementer": {
      "file": "agents/implementer.md",
      "loadsSkills": ["issues:api"],
      "purpose": "Transform plans into production-ready code via TDD"
    },
    "refactor": {
      "file": "agents/refactor.md",
      "loadsSkills": ["issues:api", "skills/plan/SKILL.md", "skills/refactoring/SKILL.md"],
      "purpose": "Plan-aware pre-validation cleanup"
    },
    "implementation-evaluator": {
      "file": "agents/implementation-evaluator.md",
      "loadsSkills": ["issues:api", "skills/plan/SKILL.md"],
      "purpose": "Evaluate implementation quality for production readiness"
    },
    "session": {
      "file": "agents/session.md",
      "loadsSkills": ["skills/session/SKILL.md"],
      "purpose": "Research Claude Code session transcripts"
    }
  },
  "bin": {
    "create-worktree.sh": {
      "purpose": "Create git worktree with automatic commitSha posting via hooks",
      "calledBy": ["skills/issue-implementation/SKILL.md", "skills/issue-implementation-with-plan/SKILL.md"]
    },
    "remove-worktree.sh": {
      "purpose": "Remove worktree and delete associated branch",
      "calledBy": ["skills/issue-merge/SKILL.md"]
    },
    "discover-workspace-api.sh": {
      "purpose": "Discover Issues API base URL for current workspace",
      "calledBy": ["bin/lib/api.sh", "hooks"]
    },
    "find-session-files.sh": {
      "purpose": "Retrieve session metadata and file paths",
      "calledBy": ["skills/session/SKILL.md"]
    },
    "hooks/ipc/dispatcher.active.sh": {
      "purpose": "Signal active session to dispatcher",
      "triggeredBy": "hooks/hooks.json:SessionStart,UserPromptSubmit"
    },
    "hooks/ipc/dispatcher.idle.sh": {
      "purpose": "Signal idle session to dispatcher",
      "calledBy": ["hooks/issue/context.stop.sh"]
    },
    "hooks/issue/context.startup.sh": {
      "purpose": "Load full issue data on new session",
      "triggeredBy": "hooks/hooks.json:SessionStart:startup"
    },
    "hooks/issue/context.resume.sh": {
      "purpose": "Load issue diff on session resume",
      "triggeredBy": "hooks/hooks.json:SessionStart:resume"
    },
    "hooks/issue/context.stop.sh": {
      "purpose": "Check for updates before stopping",
      "triggeredBy": "hooks/hooks.json:Stop"
    },
    "hooks/issue/session.start.sh": {
      "purpose": "Post sessionId comment for resumption",
      "triggeredBy": "hooks/hooks.json:SessionStart"
    },
    "hooks/issue/session.end.sh": {
      "purpose": "Clean up API watermark",
      "triggeredBy": "hooks/hooks.json:SessionEnd"
    },
    "hooks/skills/state.track.sh": {
      "purpose": "Track skill usage for reload after compaction",
      "triggeredBy": "hooks/hooks.json:PostToolUse:Skill"
    },
    "hooks/skills/state.reload.sh": {
      "purpose": "Reload skills after context compaction",
      "triggeredBy": "hooks/hooks.json:SessionStart:compact"
    },
    "hooks/skills/state.cleanup.sh": {
      "purpose": "Clean up skill state at session end",
      "triggeredBy": "hooks/hooks.json:SessionEnd"
    },
    "lib/api.sh": {
      "purpose": "Shared API utilities for hooks",
      "usedBy": ["hooks/issue/*", "hooks/ipc/*"]
    },
    "lib/state.sh": {
      "purpose": "Shared state file utilities",
      "usedBy": ["hooks/skills/*"]
    },
    "lib/output.sh": {
      "purpose": "Shared JSON output builders",
      "usedBy": ["hooks/issue/*", "hooks/skills/*"]
    }
  },
  "hooks": {
    "file": "hooks/hooks.json",
    "events": {
      "SessionStart": ["hooks/ipc/dispatcher.active.sh", "hooks/issue/session.start.sh"],
      "SessionStart:startup": ["hooks/issue/context.startup.sh"],
      "SessionStart:resume": ["hooks/issue/context.resume.sh"],
      "SessionStart:compact": ["hooks/skills/state.reload.sh"],
      "UserPromptSubmit": ["hooks/ipc/dispatcher.active.sh"],
      "PostToolUse:Skill": ["hooks/skills/state.track.sh"],
      "SessionEnd": ["hooks/skills/state.cleanup.sh", "hooks/issue/session.end.sh"],
      "Stop": ["hooks/issue/context.stop.sh"]
    }
  },
  "hotspots": {
    "skill-routing": "skills/skill-routing/SKILL.md — All issue processing flows through here",
    "issue-implementation-with-plan": "skills/issue-implementation-with-plan/SKILL.md — Orchestrates full implementation pipeline",
    "hooks": "hooks/hooks.json — Event-driven automation for session lifecycle",
    "create-worktree": "bin/create-worktree.sh — Git isolation with automatic API integration"
  }
}
