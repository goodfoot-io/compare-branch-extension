{
  "name": "@cards/sdk",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./src/index.ts",
    "./protocol": "./src/protocol/index.ts",
    "./client": "./src/client/index.ts",
    "./client/discovery": "./src/client/api-discovery.ts",
    "./config": "./src/config/index.ts",
    "./config/factories": "./src/config/factories/index.ts",
    "./config/factories/*": "./src/config/factories/*.ts",
    "./config/cli": "./src/config/cli/index.ts",
    "./config/runtime": "./src/config/runtime.ts",
    "./config/logger": "./src/config/logger.ts",
    "./config/schema": "./src/config/schema.ts",
    "./config/env": "./src/config/env.ts",
    "./marketplace": "./src/marketplace.ts",
    "./stream-store": "./src/stream-store/index.ts",
    "./worktree": "./src/worktree.ts",
    "./worktree-for-card": "./src/worktreeForCard.ts",
    "./worktree-include": "./src/worktreeInclude.ts",
    "./client/cardRepoFilters": "./src/client/cardRepoFilters.ts",
    "./card-repo": "./src/cardRepo.ts",
    "./card-summary": "./src/cardSummary.ts",
    "./search-utils": "./src/searchUtils.ts",
    "./bin/spawn-transcript-watcher": "./src/bin/spawn-transcript-watcher.ts",
    "./bin/spawn-adhoc-cleanup": "./src/bin/spawn-adhoc-cleanup.ts",
    "./bin/process-utils": "./src/bin/process-utils.ts",
    "./bin/adhoc-refs": "./src/bin/adhoc-refs.ts",
    "./process-tree": "./src/process-tree.ts",
    "./session-resolver": "./src/session-resolver.ts",
    "./pending-bind": "./src/pendingBind.ts",
    "./adhoc-attribution": "./src/adhocAttribution.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "cards-sdk": "./dist/cli.js"
  },
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "build:scaffold": "node -e \"require('fs').rmSync('../../claude/cards/scaffold',{recursive:true,force:true})\" && node -e \"require('fs').mkdirSync('../../claude/cards/scaffold',{recursive:true})\" && node -e \"require('fs').cpSync('src/scaffold','../../claude/cards/scaffold',{recursive:true,dereference:true})\"",
    "build": "node -e \"for(const p of ['../../claude/cards/bin','dist'])require('fs').rmSync(p,{recursive:true,force:true})\" && yarn build:scaffold && yarn build:cli && yarn build:card && yarn build:card-cli && yarn build:create-worktree && yarn build:create-worktree-cli && yarn build:remove-worktree && yarn build:remove-worktree-cli && yarn build:cards-extension && yarn build:cards-extension-cli && yarn build:cards-dev && yarn build:cards-dev-cli && yarn build:transcript-watcher && yarn build:transcript-watcher-cli && yarn build:adhoc-cleanup && yarn build:adhoc-cleanup-cli",
    "build:cli": "esbuild src/config/cli.ts --bundle --platform=node --format=esm --outfile=dist/cli.js --packages=external --banner:js='#!/usr/bin/env node'",
    "build:card": "node -e \"require('fs').mkdirSync('../../claude/cards/bin',{recursive:true})\" && esbuild src/bin/card.ts --bundle --platform=node --format=esm --tree-shaking=true --outfile=../../claude/cards/bin/card.mjs '--external:node:*'",
    "build:card-cli": "node -e \"require('fs').mkdirSync('../../claude/cards/bin',{recursive:true})\" && node -e \"const fs=require('fs');fs.copyFileSync('src/bin/card.sh','../../claude/cards/bin/card');if(process.platform!=='win32')fs.chmodSync('../../claude/cards/bin/card',0o755);fs.copyFileSync('src/bin/card.cmd','../../claude/cards/bin/card.cmd')\"",
    "build:create-worktree": "node -e \"require('fs').mkdirSync('../../claude/cards/bin',{recursive:true})\" && esbuild src/bin/create-worktree.ts --bundle --platform=node --format=esm --tree-shaking=true --outfile=../../claude/cards/bin/create-worktree.mjs '--external:node:*'",
    "build:create-worktree-cli": "node -e \"require('fs').mkdirSync('../../claude/cards/bin',{recursive:true})\" && node -e \"const fs=require('fs');fs.copyFileSync('src/bin/create-worktree.sh','../../claude/cards/bin/create-worktree');if(process.platform!=='win32')fs.chmodSync('../../claude/cards/bin/create-worktree',0o755);fs.copyFileSync('src/bin/create-worktree.cmd','../../claude/cards/bin/create-worktree.cmd')\"",
    "build:remove-worktree": "node -e \"require('fs').mkdirSync('../../claude/cards/bin',{recursive:true})\" && esbuild src/bin/remove-worktree.ts --bundle --platform=node --format=esm --tree-shaking=true --outfile=../../claude/cards/bin/remove-worktree.mjs '--external:node:*'",
    "build:remove-worktree-cli": "node -e \"require('fs').mkdirSync('../../claude/cards/bin',{recursive:true})\" && node -e \"const fs=require('fs');fs.copyFileSync('src/bin/remove-worktree.sh','../../claude/cards/bin/remove-worktree');if(process.platform!=='win32')fs.chmodSync('../../claude/cards/bin/remove-worktree',0o755);fs.copyFileSync('src/bin/remove-worktree.cmd','../../claude/cards/bin/remove-worktree.cmd')\"",
    "build:cards-extension": "node -e \"require('fs').mkdirSync('../../claude/cards/bin',{recursive:true})\" && esbuild src/bin/cards-extension.ts --bundle --platform=node --format=esm --tree-shaking=true --outfile=../../claude/cards/bin/cards-extension.mjs '--external:node:*'",
    "build:cards-extension-cli": "node -e \"require('fs').mkdirSync('../../claude/cards/bin',{recursive:true})\" && node -e \"const fs=require('fs');fs.copyFileSync('src/bin/cards-extension-cli.sh','../../claude/cards/bin/cards-extension');if(process.platform!=='win32')fs.chmodSync('../../claude/cards/bin/cards-extension',0o755);fs.copyFileSync('src/bin/cards-extension-cli.cmd','../../claude/cards/bin/cards-extension.cmd')\"",
    "build:cards-dev": "node -e \"require('fs').mkdirSync('../../claude/cards/bin',{recursive:true})\" && esbuild src/bin/cards-dev.ts --bundle --platform=node --format=esm --tree-shaking=true --outfile=../../claude/cards/bin/cards-dev.mjs '--external:node:*' \"--banner:js=import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\"",
    "build:cards-dev-cli": "node -e \"require('fs').mkdirSync('../../claude/cards/bin',{recursive:true})\" && node -e \"const fs=require('fs');fs.copyFileSync('src/bin/cards-dev-cli.sh','../../claude/cards/bin/cards-dev-cli');if(process.platform!=='win32')fs.chmodSync('../../claude/cards/bin/cards-dev-cli',0o755);fs.copyFileSync('src/bin/cards-dev-cli.cmd','../../claude/cards/bin/cards-dev-cli.cmd')\"",
    "build:transcript-watcher": "node -e \"require('fs').mkdirSync('../../claude/cards/bin',{recursive:true})\" && esbuild src/bin/transcript-watcher.ts --bundle --platform=node --format=esm --tree-shaking=true --outfile=../../claude/cards/bin/transcript-watcher.mjs '--external:node:*'",
    "build:transcript-watcher-cli": "node -e \"require('fs').mkdirSync('../../claude/cards/bin',{recursive:true})\" && node -e \"const fs=require('fs');fs.copyFileSync('src/bin/transcript-watcher.sh','../../claude/cards/bin/transcript-watcher');if(process.platform!=='win32')fs.chmodSync('../../claude/cards/bin/transcript-watcher',0o755);fs.copyFileSync('src/bin/transcript-watcher.cmd','../../claude/cards/bin/transcript-watcher.cmd')\"",
    "build:adhoc-cleanup": "node -e \"require('fs').mkdirSync('../../claude/cards/bin',{recursive:true})\" && esbuild src/bin/adhoc-cleanup.ts --bundle --platform=node --format=esm --tree-shaking=true --outfile=../../claude/cards/bin/adhoc-cleanup.mjs '--external:node:*'",
    "build:adhoc-cleanup-cli": "node -e \"require('fs').mkdirSync('../../claude/cards/bin',{recursive:true})\" && node -e \"const fs=require('fs');fs.copyFileSync('src/bin/adhoc-cleanup.sh','../../claude/cards/bin/adhoc-cleanup');if(process.platform!=='win32')fs.chmodSync('../../claude/cards/bin/adhoc-cleanup',0o755);fs.copyFileSync('src/bin/adhoc-cleanup.cmd','../../claude/cards/bin/adhoc-cleanup.cmd')\"",
    "lint": "biome check --write --unsafe --max-diagnostics 500 ./src ./test && jsdoczoom -l",
    "test": "vitest-unchanged"
  },
  "dependencies": {
    "@cards/sessions": "workspace:*",
    "@typescript/native-preview": "^7.0.0-dev",
    "esbuild": "^0.28.0",
    "glob": "^13.0.0",
    "ignore": "^7.0.5",
    "jsonpath-plus": "^10.4.0",
    "minimatch": "^10.2.5",
    "puppeteer-core": "^24.42.0",
    "typescript": "^6.0.3",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@cards/test-utils": "workspace:*",
    "@types/node": "24.x",
    "@types/ws": "^8.18.1",
    "jsdom": "^29.1.1",
    "vitest": "^4.1.5",
    "ws": "^8.20.0"
  }
}
