{
  "name": "@cards/sdk",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./src/index.ts",
    "./protocol": "./src/protocol/index.ts",
    "./client": "./src/client/index.ts",
    "./client/discovery": "./src/client/api-discovery.ts",
    "./config": "./src/config/index.ts",
    "./config/factories": "./src/config/factories/index.ts",
    "./config/factories/*": "./src/config/factories/*.ts",
    "./config/cli": "./src/config/cli/index.ts",
    "./config/runtime": "./src/config/runtime.ts",
    "./config/logger": "./src/config/logger.ts",
    "./config/schema": "./src/config/schema.ts",
    "./config/env": "./src/config/env.ts",
    "./marketplace": "./src/marketplace.ts",
    "./stream-store": "./src/stream-store/index.ts",
    "./worktree": "./src/worktree.ts",
    "./worktree-include": "./src/worktreeInclude.ts",
    "./client/cardRepoFilters": "./src/client/cardRepoFilters.ts",
    "./card-repo": "./src/cardRepo.ts",
    "./card-summary": "./src/cardSummary.ts",
    "./search-utils": "./src/searchUtils.ts",
    "./bin/spawn-transcript-watcher": "./src/bin/spawn-transcript-watcher.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "cards-sdk": "./dist/cli.js"
  },
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "build": "rm -rf ../../claude/cards/bin dist && yarn build:cli && yarn build:card && yarn build:card-cli && yarn build:create-worktree && yarn build:create-worktree-cli && yarn build:remove-worktree && yarn build:remove-worktree-cli && yarn build:cards-extension && yarn build:cards-extension-cli && yarn build:cards-dev && yarn build:cards-dev-cli && yarn build:transcript-watcher && yarn build:transcript-watcher-cli",
    "build:cli": "esbuild src/config/cli.ts --bundle --platform=node --format=esm --outfile=dist/cli.js --packages=external --banner:js='#!/usr/bin/env node'",
    "build:card": "mkdir -p ../../claude/cards/bin && esbuild src/bin/card.ts --bundle --platform=node --format=esm --tree-shaking=true --outfile=../../claude/cards/bin/card.mjs '--external:node:*'",
    "build:card-cli": "mkdir -p ../../claude/cards/bin && cp src/bin/card.sh ../../claude/cards/bin/card && chmod +x ../../claude/cards/bin/card",
    "build:create-worktree": "mkdir -p ../../claude/cards/bin && esbuild src/bin/create-worktree.ts --bundle --platform=node --format=esm --tree-shaking=true --outfile=../../claude/cards/bin/create-worktree.mjs '--external:node:*'",
    "build:create-worktree-cli": "mkdir -p ../../claude/cards/bin && cp src/bin/create-worktree.sh ../../claude/cards/bin/create-worktree && chmod +x ../../claude/cards/bin/create-worktree",
    "build:remove-worktree": "mkdir -p ../../claude/cards/bin && esbuild src/bin/remove-worktree.ts --bundle --platform=node --format=esm --tree-shaking=true --outfile=../../claude/cards/bin/remove-worktree.mjs '--external:node:*'",
    "build:remove-worktree-cli": "mkdir -p ../../claude/cards/bin && cp src/bin/remove-worktree.sh ../../claude/cards/bin/remove-worktree && chmod +x ../../claude/cards/bin/remove-worktree",
    "build:cards-extension": "mkdir -p ../../claude/cards/bin && esbuild src/bin/cards-extension.ts --bundle --platform=node --format=esm --tree-shaking=true --outfile=../../claude/cards/bin/cards-extension.mjs '--external:node:*'",
    "build:cards-extension-cli": "mkdir -p ../../claude/cards/bin && cp src/bin/cards-extension-cli.sh ../../claude/cards/bin/cards-extension && chmod +x ../../claude/cards/bin/cards-extension",
    "build:cards-dev": "mkdir -p ../../claude/cards/bin && esbuild src/bin/cards-dev.ts --bundle --platform=node --format=esm --tree-shaking=true --outfile=../../claude/cards/bin/cards-dev.mjs '--external:node:*' \"--banner:js=import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\"",
    "build:cards-dev-cli": "mkdir -p ../../claude/cards/bin && cp src/bin/cards-dev-cli.sh ../../claude/cards/bin/cards-dev-cli && chmod +x ../../claude/cards/bin/cards-dev-cli",
    "build:transcript-watcher": "mkdir -p ../../claude/cards/bin && esbuild src/bin/transcript-watcher.ts --bundle --platform=node --format=esm --tree-shaking=true --outfile=../../claude/cards/bin/transcript-watcher.mjs '--external:node:*'",
    "build:transcript-watcher-cli": "mkdir -p ../../claude/cards/bin && cp src/bin/transcript-watcher.sh ../../claude/cards/bin/transcript-watcher && chmod +x ../../claude/cards/bin/transcript-watcher",
    "lint": "biome check --write --unsafe --max-diagnostics 500 ./src ./test && jsdoczoom -l",
    "test": "vitest-unchanged"
  },
  "dependencies": {
    "@cards/sessions": "workspace:*",
    "@typescript/native-preview": "^7.0.0-dev",
    "esbuild": "^0.27.2",
    "glob": "^11.0.0",
    "ignore": "^7.0.5",
    "jsonpath-plus": "^10.4.0",
    "minimatch": "^10.2.5",
    "puppeteer-core": "^24.42.0",
    "typescript": "^5.9.3",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@cards/test-utils": "workspace:*",
    "@types/node": "24.x",
    "@types/ws": "^8.18.1",
    "jsdom": "^27.4.0",
    "vitest": "^4.0.18",
    "ws": "^8.20.0"
  }
}
