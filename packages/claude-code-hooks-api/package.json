{
  "name": "@cards/claude-code-hooks-api",
  "version": "1.0.0",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('../../claude/cards/hooks',{recursive:true,force:true})\" && claude-code-hooks -i \"src/*.ts\" -o \"../../claude/cards/hooks/hooks.json\" --log-env-var CARDS_CLAUDE_CODE_HOOKS_LOG_FILE --executable \"\\\"\\$(cat \\$HOME/.cards/VSCODE_NODE 2>/dev/null || echo node)\\\"\"",
    "test": "vitest-unchanged",
    "lint": "biome check --write --unsafe --max-diagnostics 500 ./src ./test && jsdoczoom -l",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@cards/sdk": "workspace:*",
    "@cards/sessions": "workspace:*",
    "@cards/web": "workspace:*",
    "@goodfoot/claude-code-hooks": "^1.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@cards/test-utils": "workspace:*",
    "@types/node": "24.x",
    "@typescript/native-preview": "^7.0.0-dev",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
