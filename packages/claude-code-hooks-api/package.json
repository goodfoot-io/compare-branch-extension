{
  "name": "@cards/claude-code-hooks-api",
  "version": "1.0.0",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rm -rf ../../plugins/cards/hooks && claude-code-hooks -i \"src/*.ts\" -o \"../../plugins/cards/hooks/hooks.json\" --log-env-var CLAUDE_CODE_API_HOOKS_LOG_FILE --executable \"\\$(cat \\$HOME/.cards/VSCODE_NODE 2>/dev/null || echo node)\"",
    "test": "vitest-unchanged",
    "lint": "biome check --write --unsafe --max-diagnostics 500 ./src ./test && jsdoczoom -l",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@cards/sdk": "workspace:*",
    "@cards/sessions": "workspace:*",
    "@cards/web": "workspace:*",
    "@goodfoot/claude-code-hooks": "^1.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.13",
    "@cards/test-utils": "workspace:*",
    "@types/node": "24.x",
    "@typescript/native-preview": "^7.0.0-dev",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
