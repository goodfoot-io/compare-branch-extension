{
  "name": "@cards/claude-code-hooks-api",
  "version": "1.0.0",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rm -rf ../../plugins/cards/hooks ../../plugins/cards/bin && claude-code-hooks -i \"src/*.ts\" -o \"../../plugins/cards/hooks/hooks.json\" --log-env-var CLAUDE_CODE_API_HOOKS_LOG_FILE --executable \"\\$(cat \\$HOME/.cards/VSCODE_NODE 2>/dev/null || echo node)\" && yarn build:card && yarn build:card-cli && yarn build:compare && yarn build:compare-cli && yarn build:notification && yarn build:notification-cli && yarn build:cards-dev && yarn build:cards-dev-cli",
    "build:card-cli": "cp src/bin/card-cli.sh ../../plugins/cards/bin/card-cli && chmod +x ../../plugins/cards/bin/card-cli",
    "build:compare-cli": "cp src/bin/compare-cli.sh ../../plugins/cards/bin/compare-cli && chmod +x ../../plugins/cards/bin/compare-cli",
    "build:notification-cli": "cp src/bin/notification-cli.sh ../../plugins/cards/bin/notification-cli && chmod +x ../../plugins/cards/bin/notification-cli",
    "build:cards-dev-cli": "cp src/bin/cards-dev-cli.sh ../../plugins/cards/bin/cards-dev-cli && chmod +x ../../plugins/cards/bin/cards-dev-cli",
    "build:card": "esbuild src/bin/card.ts --bundle --platform=node --format=esm --tree-shaking=true --outfile=../../plugins/cards/bin/card.mjs '--external:node:*'",
    "build:compare": "esbuild src/bin/compare.ts --bundle --platform=node --format=esm --tree-shaking=true --outfile=../../plugins/cards/bin/compare.mjs '--external:node:*'",
    "build:notification": "esbuild src/bin/notification.ts --bundle --platform=node --format=esm --tree-shaking=true --outfile=../../plugins/cards/bin/notification.mjs '--external:node:*'",
    "build:cards-dev": "esbuild src/bin/cards-dev.ts --bundle --platform=node --format=esm --tree-shaking=true --outfile=../../plugins/cards/bin/cards-dev.mjs '--external:node:*' \"--banner:js=import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\"",
    "test": "vitest-unchanged",
    "lint": "biome check --write --unsafe --max-diagnostics 500 ./src ./test && jsdoczoom -l",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@cards/claude-code-sessions": "workspace:*",
    "@cards/sdk": "workspace:*",
    "@goodfoot/claude-code-hooks": "^1.2.9",
    "esbuild": "^0.25.0",
    "puppeteer-core": "^24.36.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.13",
    "@cards/test-utils": "workspace:*",
    "@types/node": "24.x",
    "@typescript/native-preview": "^7.0.0-dev",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
