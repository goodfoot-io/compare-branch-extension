{
  "name": "@cards/claude-code-hooks-api",
  "version": "1.0.0",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build": "claude-code-hooks -i \"src/*.ts\" -o \"../../plugins/cards/hooks/hooks.json\" --log \"../../../.cards/logs/claude-code-hooks-api.log\" --executable \"\\$(cat \\$HOME/.cards/VSCODE_NODE_PATH 2>/dev/null || echo node)\"",
    "test": "vitest run --changed",
    "lint": "biome check --write --unsafe --max-diagnostics 500 ./src ./test && jsdoczoom -l",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cards/claude-code-sessions": "workspace:*",
    "@cards/sdk": "workspace:*",
    "@goodfoot/claude-code-hooks": "^1.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.13",
    "@cards/test-utils": "workspace:*",
    "@types/node": "24.x",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
