{
  "name": "@cards/configuration",
  "version": "1.0.0",
  "description": "Type-safe configuration library v2 for the Cards Extension with hooks, validators, and type configurations",
  "homepage": "https://github.com/goodfoot-io/marketplace/tree/main/public/packages/cards-configuration",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/goodfoot-io/marketplace.git",
    "directory": "public/packages/cards-configuration"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20.11.0"
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "esbuild src/cli.ts --bundle --platform=node --format=esm --outfile=dist/cli.js --packages=external --banner:js='#!/usr/bin/env node'",
    "lint": "biome check --write --unsafe --max-diagnostics 500 ./src ./tests",
    "test": "vitest run"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./factories": "./src/factories/index.ts",
    "./factories/*": "./src/factories/*.ts",
    "./cli": "./src/cli/index.ts",
    "./runtime": "./src/runtime.ts",
    "./validation": "./src/validation.ts",
    "./testing": "./src/testing.ts",
    "./logger": "./src/logger.ts",
    "./schema": "./src/schema.ts",
    "./env": "./src/env.ts",
    "./*": "./src/*.ts"
  },
  "bin": {
    "cards-configuration": "./dist/cli.js"
  },
  "dependencies": {
    "@cards/protocol": "workspace:*",
    "esbuild": "^0.25.0",
    "glob": "^11.0.0",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@types/bun": "^1.3.8",
    "@types/node": "24.x",
    "vitest": "4.0.13"
  }
}
