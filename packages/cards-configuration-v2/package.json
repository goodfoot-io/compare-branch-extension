{
  "name": "@cards/configuration-v2",
  "version": "1.0.0",
  "description": "Type-safe configuration library v2 for the Cards Extension with hooks, validators, and type configurations",
  "homepage": "https://github.com/goodfoot-io/marketplace/tree/main/public/packages/cards-configuration-v2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/goodfoot-io/marketplace.git",
    "directory": "public/packages/cards-configuration-v2"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20.11.0"
  },
  "files": [
    "dist",
    "types"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --build tsconfig.build.json",
    "lint": "biome check --write --unsafe --max-diagnostics 500 ./src ./tests",
    "test": "vitest run"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./factories": "./src/factories/index.ts",
    "./factories/*": "./src/factories/*.ts",
    "./cli": "./src/cli/index.ts",
    "./runtime": "./src/runtime.ts",
    "./validation": "./src/validation.ts",
    "./testing": "./src/testing.ts",
    "./logger": "./src/logger.ts",
    "./schema": "./src/schema.ts",
    "./env": "./src/env.ts",
    "./*": "./src/*.ts"
  },
  "bin": {
    "cards-configuration-v2": "./dist/cli.js"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./types/index.d.ts",
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "types": "./types/index.d.ts"
      },
      "./factories": {
        "import": "./dist/factories/index.js",
        "types": "./types/factories/index.d.ts"
      },
      "./factories/*": {
        "import": "./dist/factories/*.js",
        "types": "./types/factories/*.d.ts"
      },
      "./cli": {
        "import": "./dist/cli/index.js",
        "types": "./types/cli/index.d.ts"
      },
      "./runtime": {
        "import": "./dist/runtime.js",
        "types": "./types/runtime.d.ts"
      },
      "./validation": {
        "import": "./dist/validation.js",
        "types": "./types/validation.d.ts"
      },
      "./testing": {
        "import": "./dist/testing.js",
        "types": "./types/testing.d.ts"
      },
      "./logger": {
        "import": "./dist/logger.js",
        "types": "./types/logger.d.ts"
      },
      "./schema": {
        "import": "./dist/schema.js",
        "types": "./types/schema.d.ts"
      },
      "./env": {
        "import": "./dist/env.js",
        "types": "./types/env.d.ts"
      },
      "./*": {
        "import": "./dist/*.js",
        "types": "./types/*.d.ts"
      }
    },
    "bin": {
      "cards-configuration-v2": "./dist/cli.js"
    }
  },
  "dependencies": {
    "glob": "^11.0.0",
    "jiti": "^1.21.0",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@types/bun": "^1.3.8",
    "@types/node": "24.x",
    "vitest": "4.0.13"
  }
}
