{
  "name": "@cards/sdk",
  "version": "1.0.0",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20.11.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./protocol": "./src/protocol/index.ts",
    "./client": "./src/client/index.ts",
    "./config": "./src/configuration/index.ts",
    "./config/factories": "./src/configuration/factories/index.ts",
    "./config/factories/*": "./src/configuration/factories/*.ts",
    "./config/cli": "./src/configuration/cli/index.ts",
    "./config/runtime": "./src/configuration/runtime.ts",
    "./config/validation": "./src/configuration/validation.ts",
    "./config/logger": "./src/configuration/logger.ts",
    "./config/schema": "./src/configuration/schema.ts",
    "./config/env": "./src/configuration/env.ts",
    "./testing": "./src/testing.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "cards-sdk": "./dist/cli.js"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "esbuild src/cli.ts --bundle --platform=node --format=esm --outfile=dist/cli.js --packages=external --banner:js='#!/usr/bin/env node'",
    "lint": "biome check --write --unsafe --max-diagnostics 500 ./src ./test",
    "test": "vitest run"
  },
  "dependencies": {
    "esbuild": "^0.25.0",
    "glob": "^11.0.0",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.13",
    "@types/node": "24.x",
    "vitest": "^4.0.18"
  }
}
