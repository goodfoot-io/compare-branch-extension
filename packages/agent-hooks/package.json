{
  "name": "@cards/agent-hooks",
  "version": "1.0.0",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "yarn build && chokidar 'src/**/*.{ts,md,txt}' -c 'yarn build'",
    "test": "vitest-unchanged",
    "lint": "biome check --write --unsafe --max-diagnostics 500 ./src ./test && jsdoczoom -l",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@cards/sdk": "workspace:*",
    "@cards/sessions": "workspace:*",
    "@cards/web": "workspace:*",
    "@goodfoot/claude-code-hooks": "^1.7.0",
    "@goodfoot/codex-hooks": "^1.1.0",
    "esbuild": "^0.28.0",
    "js-yaml": "^4.1.1",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@cards/test-utils": "workspace:*",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "24.x",
    "@types/ws": "^8.18.1",
    "@typescript/native-preview": "^7.0.0-dev",
    "chokidar-cli": "^3.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
