{
  "name": "@goodfoot/compare-branch-configuration",
  "version": "1.0.0",
  "description": "Type-safe configuration library for the Compare Branch Extension with hooks, validators, and type configurations",
  "homepage": "https://github.com/goodfoot-io/marketplace/tree/main/public/packages/compare-branch-configuration",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/goodfoot-io/marketplace.git",
    "directory": "public/packages/compare-branch-configuration"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20.11.0"
  },
  "files": [
    "dist",
    "types"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --build tsconfig.build.json",
    "lint": "biome check --write --unsafe --max-diagnostics 500 ./src ./tests",
    "test": "vitest run"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "bin": "./dist/cli.js",
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./types/index.d.ts",
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "types": "./types/index.d.ts"
      },
      "./*": {
        "import": "./dist/*.js",
        "types": "./types/*.d.ts"
      }
    },
    "bin": {
      "compare-branch-configuration": "./dist/cli.js"
    }
  },
  "dependencies": {
    "esbuild": "^0.24.0",
    "glob": "^11.0.0",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@types/node": "^24",
    "vitest": "4.0.13"
  }
}
