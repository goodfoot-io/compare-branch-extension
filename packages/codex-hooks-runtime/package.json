{
  "name": "@cards/codex-hooks-runtime",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "node -e \"for(const p of ['../../codex/runtime/hooks','../../codex/runtime/bin','../../codex/runtime/content'])require('fs').rmSync(p,{recursive:true,force:true})\" && codex-hooks -i \"src/**/*.ts\" -o \"../../codex/runtime/hooks/hooks.json\" --loader .md=text --loader .txt=text --executable \"\\\"\\$(cat \\$HOME/.cards/VSCODE_NODE 2>/dev/null || echo node)\\\"\"",
    "watch": "yarn build && chokidar 'src/**/*.{ts,md,txt}' -c 'yarn build'",
    "test": "vitest-unchanged",
    "lint": "biome check --write --unsafe . && jsdoczoom -l",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@cards/sdk": "workspace:*",
    "@cards/sessions": "workspace:*",
    "@goodfoot/codex-hooks": "^1.0.2",
    "esbuild": "^0.28.0",
    "js-yaml": "^4.1.1",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@cards/test-utils": "workspace:*",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "24.x",
    "@types/ws": "^8.18.1",
    "@typescript/native-preview": "^7.0.0-dev",
    "chokidar-cli": "^3.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=22"
  }
}
