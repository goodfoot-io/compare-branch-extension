{
  "name": "@cards/default-configuration",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "cards-sdk build -c settings.config.ts -o dist --log .cards/logs/hooks.log",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --experimental.fsModuleCache",
    "lint": "biome check --write --unsafe --max-diagnostics 500 ./src ./test"
  },
  "dependencies": {
    "@cards/sdk": "workspace:*",
    "gray-matter": "^4.0.3"
  },
  "files": [
    "dist/**"
  ],
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.34",
    "@biomejs/biome": "^2.3.13",
    "@cards/test-utils": "workspace:*",
    "@types/node": "24.x",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=20.11.0"
  }
}
