{
  "name": "@cards/default-configuration",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "rm -rf dist && cards-sdk build -c settings.config.ts -o dist --loader .md=text && WS_ROOT=$(git rev-parse --show-toplevel) && rm -rf \"$WS_ROOT/.cards/bin\" \"$WS_ROOT/.cards/settings.json\" \"$WS_ROOT/.cards/www\" && cp -r ./dist/* \"$WS_ROOT/.cards/\"",
    "watch": "yarn build && chokidar 'src/**/*.ts' -c 'yarn build'",
    "typecheck": "tsgo --noEmit",
    "test": "vitest-unchanged",
    "lint": "biome check --write --unsafe --max-diagnostics 500 ./src ./test && jsdoczoom -l"
  },
  "dependencies": {
    "@cards/claude-code-sessions": "workspace:*",
    "@cards/sdk": "workspace:*",
    "gray-matter": "^4.0.3",
    "marked": "^17.0.4"
  },
  "files": [
    "dist/**"
  ],
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.34",
    "@biomejs/biome": "^2.3.13",
    "@cards/test-utils": "workspace:*",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "24.x",
    "@typescript/native-preview": "^7.0.0-dev",
    "chokidar-cli": "^3.0.0",
    "fs-extra": "^11.3.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=22"
  }
}
