{
  "name": "@cards/default-configuration",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "rm -rf dist && cards-sdk build -c settings.config.ts -o dist --loader .md=text && yarn build:www && find dist/www/claude-code-session -mindepth 1 ! -name 'index.html' -delete && WS_ROOT=$(git rev-parse --show-toplevel) && rm -rf \"$WS_ROOT/.cards/bin\" \"$WS_ROOT/.cards/settings.json\" \"$WS_ROOT/.cards/www\" && cp -r ./dist/* \"$WS_ROOT/.cards/\"",
    "build:www": "bun run src/streams/claude-code-session/www/build.ts",
    "watch": "yarn build && chokidar 'src/**/*.ts' -c 'yarn build'",
    "watch:www": "bun build --watch ./src/streams/claude-code-session/www/index.html --outdir=dist/www/claude-code-session",
    "typecheck": "tsgo --noEmit && tsgo --noEmit -p src/streams/claude-code-session/www/tsconfig.json",
    "test": "vitest-unchanged",
    "lint": "biome check --write --unsafe --max-diagnostics 500 ./src ./test && jsdoczoom -l"
  },
  "dependencies": {
    "@cards/sdk": "workspace:*",
    "@cards/sessions": "workspace:*",
    "@vscode/codicons": "^0.0.45",
    "js-yaml": "^4.1.1",
    "marked": "^17.0.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "smol-toml": "^1.6.1",
    "zustand": "^5.0.0"
  },
  "files": [
    "dist/**"
  ],
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.34",
    "@biomejs/biome": "^2.4.14",
    "@cards/test-utils": "workspace:*",
    "@types/bun": "^1.3.13",
    "@types/fs-extra": "^11.0.4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "24.x",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript/native-preview": "^7.0.0-dev",
    "bun": "^1.3.13",
    "bun-plugin-tailwind": "^0.1.2",
    "chokidar-cli": "^3.0.0",
    "fs-extra": "^11.3.4",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18",
    "zod": "^4.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
