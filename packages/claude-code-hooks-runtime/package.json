{
  "name": "@cards/claude-code-hooks-runtime",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "claude-code-hooks -i \"src/**/*.ts\" -o \"../../plugins/runtime/hooks/hooks.json\" --log \"../../../.cards/logs/runtime-hooks.log\" --executable \"\\$(cat \\$HOME/.cards/VSCODE_NODE_PATH 2>/dev/null || echo node)\"",
    "test": "vitest run",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cards/sdk": "workspace:*",
    "@goodfoot/claude-code-hooks": "^1.0.21"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.13",
    "@types/node": "24.x",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=20.11.0"
  }
}
