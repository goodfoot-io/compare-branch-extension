{
  "name": "@cards/claude-code-hooks-runtime",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "claude-code-hooks -i \"src/**/*.ts\" -o \"../../plugins/runtime/hooks/hooks.json\" --log \"../../../.cards/logs/claude-code-cards-runtime-hooks.log\" --executable \"\\$(cat \\$HOME/.cards/VSCODE_NODE 2>/dev/null || echo node)\" && yarn build:uuid7 && yarn build:card && yarn build:watcher",
    "build:uuid7": "esbuild src/bin/uuid7.ts --bundle --platform=node --format=esm --outfile=../../plugins/runtime/bin/uuid7.mjs --packages=external",
    "build:card": "esbuild src/bin/card.ts --bundle --platform=node --format=esm --outfile=../../plugins/runtime/bin/card.mjs --packages=external",
    "build:watcher": "esbuild src/bin/transcript-watcher.ts --bundle --platform=node --format=esm --outfile=../../plugins/runtime/bin/transcript-watcher.mjs '--external:node:*'",
    "watch": "yarn build && chokidar 'src/**/*.ts' -c 'yarn build'",
    "test": "vitest-unchanged",
    "lint": "biome check . && jsdoczoom -l",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cards/claude-code-sessions": "workspace:*",
    "@cards/sdk": "workspace:*",
    "@goodfoot/claude-code-hooks": "^1.1.0",
    "esbuild": "^0.25.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.13",
    "@cards/test-utils": "workspace:*",
    "@types/node": "24.x",
    "chokidar-cli": "^3.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=20.11.0"
  }
}
