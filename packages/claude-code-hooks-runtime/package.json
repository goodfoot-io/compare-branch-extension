{
  "name": "@cards/claude-code-hooks-runtime",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "rm -rf ../../claude/runtime/hooks ../../claude/runtime/bin ../../claude/runtime/content && claude-code-hooks -i \"src/**/*.ts\" -o \"../../claude/runtime/hooks/hooks.json\" --loader .md=text --loader .txt=text --log-env-var CLAUDE_CODE_RUNTIME_HOOKS_LOG_FILE --executable \"\\$(cat \\$HOME/.cards/VSCODE_NODE 2>/dev/null || echo node)\" && yarn build:mcp-server",
    "build:mcp-server": "esbuild ../cards-mcp-server/src/index.ts --bundle --platform=node --format=esm --tree-shaking=true --outfile=../../claude/runtime/bin/cards-mcp-server.mjs '--external:node:*'",
    "watch": "yarn build && chokidar 'src/**/*.{ts,md,txt}' -c 'yarn build'",
    "test": "vitest-unchanged",
    "lint": "biome check --write --unsafe . && jsdoczoom -l",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@cards/sdk": "workspace:*",
    "@cards/sessions": "workspace:*",
    "@goodfoot/claude-code-hooks": "^1.3.3",
    "esbuild": "^0.28.0",
    "js-yaml": "^4.1.1",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@cards/test-utils": "workspace:*",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "24.x",
    "@types/ws": "^8.18.1",
    "@typescript/native-preview": "^7.0.0-dev",
    "chokidar-cli": "^3.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=22"
  }
}
